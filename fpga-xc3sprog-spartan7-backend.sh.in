#!/bin/sh
# Fixed-operation backend for the FPGA Flasher service.
#
# This is intentionally not a general XC3SPROG wrapper: callers cannot choose
# the cable, JTAG position, BSCAN image, flash range, target or verification
# policy.  It is installed only by the private Spartan-7 appliance package.
set -eu

XC3SPROG="@CMAKE_INSTALL_PREFIX@/bin/xc3sprog"
XPC2_LOADER="@CMAKE_INSTALL_PREFIX@/bin/xc3sprog-xpc2.sh"
XPC2_FIRMWARE="@CMAKE_INSTALL_PREFIX@/bin/xusb_xp2.hex"
BSCAN="@CMAKE_INSTALL_PREFIX@/share/xc3sprog/bscan_spi/xc7s50csga324-1.bit"
EXPECTED_IDCODE="0x0362f093"
EXPECTED_JEDEC="9d6018"
FLASH_CAPACITY_BYTES=16777216

operation=""
image=""
output=""

usage() {
    echo "Usage: $0 --operation=probe|flash|backup [--image=/absolute/path/image.bin] [--output=/absolute/path/backup.bin]" >&2
    exit 2
}

for argument in "$@"; do
    case "$argument" in
        --operation=probe|--operation=flash|--operation=backup) operation="${argument#*=}" ;;
        --image=*) image="${argument#*=}" ;;
        --output=*) output="${argument#*=}" ;;
        *) usage ;;
    esac
done

[ -n "$operation" ] || usage
if [ "$operation" = flash ]; then
    [ -n "$image" ] && [ -f "$image" ] || { echo "Programming image is unavailable." >&2; exit 2; }
    [ -z "$output" ] || usage
    case "$image" in
        /data/app-data/fpga-flasher-webapp/uploads/*|/usr/share/fpga-flasher/artifacts/*) ;;
        *) echo "Programming image is outside approved service storage." >&2; exit 2 ;;
    esac
    image_bytes="$(wc -c < "$image" | tr -d ' ')"
    case "$image_bytes" in
        ''|*[!0-9]*) echo "Programming image size is invalid." >&2; exit 2 ;;
    esac
    [ "$image_bytes" -gt 0 ] && [ "$image_bytes" -le "$FLASH_CAPACITY_BYTES" ] || {
        echo "Programming image exceeds configuration storage capacity." >&2; exit 2;
    }
elif [ "$operation" = backup ]; then
    [ -z "$image" ] && [ -n "$output" ] || usage
    output_dir="$(dirname "$output")"
    output_base="$(basename "$output")"
    [ "$output_dir" = "/data/app-data/fpga-flasher-webapp/backups" ] && \
        [ "$output_base" != "$output" ] || {
        echo "Backup destination is outside protected service storage." >&2
        exit 2
    }
    case "$output_base" in
        .bkp_*.tmp) ;;
        *) echo "Backup destination name is invalid." >&2; exit 2 ;;
    esac
    [ ! -e "$output" ] || { echo "Backup destination already exists." >&2; exit 2; }
else
    [ -z "$image" ] && [ -z "$output" ] || usage
fi

[ -x "$XC3SPROG" ] && [ -x "$XPC2_LOADER" ] && [ -r "$XPC2_FIRMWARE" ] && [ -r "$BSCAN" ] || {
    echo "Required XC3SPROG backend assets are unavailable." >&2; exit 2;
}

# VirtualBox can pass multiple identical cables through; do not guess which is
# connected to the target.  Firmware loading happens only after this guard.
adapter_count="$(lsusb -d 03fd:0013 2>/dev/null | wc -l | tr -d ' ')"
[ "$adapter_count" = 1 ] || {
    echo "Exactly one Xilinx Platform Cable USB adapter must be attached." >&2; exit 2;
}

"$XPC2_LOADER" --xpc-firmware="$XPC2_FIRMWARE"

# BSCAN turns the FPGA into an SPI bridge, so its output reports the flash
# JEDEC ID rather than the FPGA's JTAG IDCODE.  Verify the FPGA first, then
# install BSCAN and verify the configuration storage separately.
target_output="$("$XC3SPROG" -c xpc2 -p 0 2>&1)" || {
    printf '%s\n' "$target_output" >&2
    echo "JTAG target probe failed." >&2
    exit 2
}
normalized_target="$(printf '%s' "$target_output" | tr '[:upper:]' '[:lower:]')"
case "$normalized_target" in
    *"idcode: $EXPECTED_IDCODE"*) ;;
    *) echo "Unexpected JTAG target." >&2; exit 2 ;;
esac

probe_output="$("$XC3SPROG" -c xpc2 -p 0 -I"$BSCAN" 2>&1)" || {
    printf '%s\n' "$probe_output" >&2
    echo "Configuration storage probe failed." >&2
    exit 2
}
normalized_jedec="$(printf '%s' "$probe_output" | tr '[:upper:]' '[:lower:]' | sed 's/0x//g' | tr -cd '0-9a-f')"
case "$normalized_jedec" in
    *"$EXPECTED_JEDEC"*) ;;
    *) echo "Unexpected configuration storage." >&2; exit 2 ;;
esac

if [ "$operation" = probe ]; then
    echo "Target and configuration storage probe passed."
    exit 0
fi

if [ "$operation" = backup ]; then
    umask 077
    readback_output="$("$XC3SPROG" -c xpc2 -I"$BSCAN" -p 0 "${output}:R:0:BIN:${FLASH_CAPACITY_BYTES}" 2>&1)" || {
        printf '%s\n' "$readback_output" >&2
        rm -f "$output"
        echo "Configuration storage readback failed." >&2
        exit 2
    }
    output_bytes="$(wc -c < "$output" | tr -d ' ')"
    [ "$output_bytes" = "$FLASH_CAPACITY_BYTES" ] || {
        rm -f "$output"
        echo "Configuration storage readback length is invalid." >&2
        exit 2
    }
    printf '%s\n' "$readback_output"
    echo "Configuration storage readback passed."
    exit 0
fi

flash_output="$("$XC3SPROG" -c xpc2 -I"$BSCAN" -p 0 "${image}:w:0:BIN" 2>&1)" || {
    printf '%s\n' "$flash_output" >&2
    echo "Programming failed." >&2
    exit 2
}
printf '%s\n' "$flash_output"
printf '%s' "$flash_output" | grep -q 'Verify: Success!' || {
    echo "Programming completed without a positive verification result." >&2
    exit 2
}
echo "FPGA-FLASHER:VERIFY-PASSED"
echo "Programming and verification passed."
